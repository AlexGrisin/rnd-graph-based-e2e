BASE_URL=https://www.beaverbrooks.co.uk/
APP_EMAIL=your-email@example.com
APP_PASSWORD=your-password

# Optional advisory evaluator. Disabled unless explicitly set to true.
# When enabled, masked screenshots and route metadata are sent to the LLM gateway.
LLM_JUDGE_ENABLED=false
LLM_GATEWAY_TOKEN=replace-with-your-llm-gateway-token
LLM_GATEWAY_URL=https://api.openai.com/v1
LLM_JUDGE_MODEL=gpt-4o-mini
LLM_JUDGE_MODEL_VERSION=unversioned-alias
# Evaluation granularity: route (default), step, or both.
LLM_JUDGE_SCOPE=both
# Debug only: attach the full provider response to the Playwright report.
LLM_JUDGE_ATTACH_RAW_RESPONSE=false
